# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: PORT=5000  (macOS AirPlay can use 5000; try PORT=5055)
# DATABASE_URL=sqlite:///virtualtourism.db

# Comma-separated emails that get the admin panel after signing in with OAuth
ADMIN_EMAILS=you@example.com

# Judge/demo access without OAuth (1 = show "Continue as demo visitor")
DEMO_LOGIN=1
# Set a secret to enable /login-demo-admin?key=<secret> (admin panel for judges). Leave empty to disable.
DEMO_ADMIN_KEY=

# OAuth apps (leave blank to hide a provider). Redirect URI: https://<your-host>/auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set to 1 when served over HTTPS
COOKIE_SECURE=0
