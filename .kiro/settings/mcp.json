  {
    "mcpServers": {
      "blender": {
        "command": "/opt/homebrew/bin/uvx",
        "args": ["--python", "3.11", "mcp-for-blender"],
        "env": { "UV_PYTHON_PREFERENCE": "only-managed" },
        "disabled": false
      },
      "osm-mcp-server": {
        "command": "/opt/homebrew/bin/uvx",
        "args": ["--with", "mcp<2", "osm-mcp-server"],
        "disabled": false
      }
    }
  }
